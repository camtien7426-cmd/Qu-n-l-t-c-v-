// TaskFlow - lược đồ cơ sở dữ liệu (6 bảng theo mục 5.3 của đặc tả)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEADER
  MEMBER
}

enum TaskStatus {
  TODO        // Chưa thực hiện
  IN_PROGRESS // Đang thực hiện
  DONE        // Hoàn thành
}

enum Priority {
  LOW    // Thấp
  MEDIUM // Trung bình
  HIGH   // Cao
}

enum NotificationType {
  TASK_ASSIGNED // Được giao công việc mới
  NEW_COMMENT   // Có bình luận mới
  DUE_SOON      // Sắp đến hạn (trong 48 giờ)
  OVERDUE       // Quá hạn
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  passwordHash      String
  avatarUrl         String?
  // Đặt lại mật khẩu: lưu bản băm của token, hạn 15 phút, dùng một lần
  resetTokenHash    String?
  resetTokenExpires DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
  comments      Comment[]
  notifications Notification[]
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members       ProjectMember[]
  tasks         Task[]
  notifications Notification[]
}

// Vai trò theo từng dự án. Mỗi dự án có đúng một LEADER (kiểm tra ở tầng ứng dụng).
model ProjectMember {
  projectId Int
  userId    Int
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// Công việc và công việc con dùng chung một bảng:
// parentId = null  -> công việc chính
// parentId != null -> công việc con (chỉ 1 cấp, kiểm tra ở tầng ứng dụng)
model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId  Int
  assigneeId Int?
  parentId   Int?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  comments      Comment[]
  notifications Notification[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([parentId])
  @@index([dueDate])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId   Int
  authorId Int

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId    Int
  projectId Int?
  taskId    Int?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
